PORT=3000
# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_KEY_FILE_PATH=./path-to-your-service-account-key.json

# Security Credentials
# Master Secret Key must be exactly 32 bytes (256-bit) encoded in base64.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_SECRET_KEY=your-32-byte-base64-secret-key

# DCR (Dynamic Client Registration) Persistence Mode: STATELESS, MEMORY, or FIRESTORE
DCR_PERSISTENCE_MODE=STATELESS

# BigQuery Allowlist Configuration (comma-separated dataset.table)
# You can use multiline strings with double quotes for better readability
ALLOWLIST_TABLES="
  my_dataset.transactions_qris,
  my_dataset.customers_summary,
  another_dataset.financial_reports
"

# Optional Login Credentials for Mock OAuth Flow
MOCK_USER_EMAIL=user@example.com
MOCK_USER_PASSWORD=secret-password

# Mode Autentikasi: MOCK atau OIDC
AUTH_PROVIDER=MOCK

# Konfigurasi jika AUTH_PROVIDER=OIDC
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/authorize
OIDC_TOKEN_ENDPOINT=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
OIDC_REDIRECT_URI=https://your-tunnel-domain.trycloudflare.com/oauth/callback

# BigQuery Limits
MAX_BYTES_BILLED=10737418240
ROW_LIMIT=1000

# Security Configuration
ALLOWED_CORS_ORIGINS=https://api.atlassian.com,http://localhost:3000
ALLOWED_EMAIL_DOMAINS=example.com
ALLOWED_REDIRECT_URIS=https://api.atlassian.com/oauth2/rovo/callback,http://localhost:3000/callback
TOKEN_EXPIRATION=1h
TOKEN_EXPIRATION_SECONDS=3600

# Downstream Connectivity / Drivers
# Comma-separated list of active drivers (e.g., bigquery, stdio, sse)
ACTIVE_DRIVERS=bigquery

# Stdio Downstream Configuration (Required if ACTIVE_DRIVERS contains 'stdio')
STDIO_DRIVER_COMMAND=node
STDIO_DRIVER_ARGS=./tests/mock-stdio-server.js

# SSE Downstream Configuration (Required if ACTIVE_DRIVERS contains 'sse')
SSE_DRIVER_URL=http://localhost:4000/sse

# Generic Inbound Adapter (Cursor / Claude Code) API Key (optional)
GENERIC_ADAPTER_API_KEY=

# ==========================================
# Dual-Mode Governance & Budgeting (Fase 4)
# ==========================================
# Mode Personal: 0 atau kosong untuk unlimited
# Mode Enterprise: Tentukan batas kuota dan rate limit
USER_DAILY_BUDGET_BYTES=10737418240  # 10 GB per user per hari (0 = unlimited / Personal Mode)
RATE_LIMIT_MAX_REQUESTS=60           # 60 request per window (0 = unthrottled / Personal Mode)
RATE_LIMIT_WINDOW_MS=60000           # 60 detik / 1 menit sliding window
LOCAL_USER_EMAIL=developer@localhost # Identitas default untuk Cursor/Claude lokal

# ==========================================
# Downstream MCP Credentials (Option 1 Consolidation)
# ==========================================
SONARQUBE_TOKEN=your-sonarqube-or-sonarcloud-token
SONARQUBE_ORG=your-sonar-organization
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token
NOTION_API_KEY=ntn_your_notion_integration_token
CLICKSTACK_SERVICE_ID=your-clickstack-service-id
DD_API_KEY=your-datadog-api-key
DD_APPLICATION_KEY=your-datadog-application-key
