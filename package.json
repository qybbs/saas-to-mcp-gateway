{
  "name": "saas-to-mcp-gateway",
  "version": "1.1.0",
  "description": "Universal, FinOps-aware Enterprise SaaS-to-MCP Gateway connecting coding agents (Cursor, Claude Code, OpenCode, Antigravity, Atlassian Rovo) to downstream tools and data sources with zero secret sprawl.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "bigquery",
    "finops",
    "atlassian-rovo",
    "cursor",
    "claude-code",
    "opencode",
    "antigravity"
  ],
  "author": "Muhammad Iqbal Ghozy",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/firestore": "^8.7.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
