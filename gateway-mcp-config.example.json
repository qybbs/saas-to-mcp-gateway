{
  "outboundDrivers": {
    "bigquery": {
      "type": "stdio",
      "command": "node",
      "args": ["../custom-bigquery-mcp/dist/index.js"],
      "env": {
        "GCP_PROJECT_ID": "${GCP_PROJECT_ID}",
        "ALLOWLIST_TABLES": "${ALLOWLIST_TABLES}"
      }
    },
    "sonarqube": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "sonarqube-api-mcp"],
      "env": {
        "SONAR_HOST_URL": "https://sonarcloud.io",
        "SONAR_TOKEN": "${SONARQUBE_TOKEN}"
      }
    },
    "internal-tool": {
      "type": "sse",
      "url": "http://localhost:4000/sse"
    }
  },
  "inboundAdapters": {
    "atlassian": {
      "enabled": true,
      "allowedDrivers": ["bigquery"]
    },
    "generic": {
      "enabled": true,
      "allowedDrivers": ["bigquery", "sonarqube", "internal-tool"],
      "apiKey": "${GENERIC_ADAPTER_API_KEY}"
    },
    "openai": {
      "enabled": true,
      "allowedDrivers": ["bigquery", "sonarqube", "internal-tool"],
      "apiKey": "${OPENAI_ADAPTER_API_KEY}"
    }
  }
}
